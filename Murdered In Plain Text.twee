Keystone exhibits &mdash; the three an accusation cannot stand without:<br>
<<for _i, _item range setup.keystones()>><<if setup.has(_item.id)>><span class="ok">&#10003;</span> <<= _item.title>> <span class="dim">&mdash; <<= _item.where>></span><<else>><span class="bad">&#10007;</span> <span class="dim">Keystone <<= _i + 1>> &mdash; still out there, on day <<= _item.day>></span><</if>><br><</for>>
</div>

<div class="evidence-grid">
<<for _i, _item range setup.evidence>>\
<<if setup.has(_item.id)>>\
<div class="evidence-card <<if _item.keystone>>evidence-card--keystone<</if>>">
	<h3><<= _item.title>></h3>
	<span class="where">Day <<= _item.day>> &middot; <<= _item.where>></span>
	<p><<= _item.note>></p>
</div>
<<elseif _item.day <= $day>>\
<div class="evidence-card evidence-card--missing">
	<h3>Exhibit not recovered</h3>
	<span class="where">Day <<= _item.day>> &middot; <<= _item.where>></span>
	<p><span class="redacted">&#9608;&#9608;&#9608;&#9608;&#9608;&#9608;&#9608;&#9608;&#9608;&#9608;&#9608;&#9608;&#9608;&#9608;&#9608;&#9608;&#9608;&#9608;&#9608;&#9608;&#9608;&#9608;&#9608;&#9608;&#9608;&#9608;&#9608;&#9608;&#9608;</span></p>
</div>
<</if>>\
<</for>>
</div>

