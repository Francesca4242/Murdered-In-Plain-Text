:: StoryInit
/* Every piece of state the case depends on is declared here, once, so that a
   puzzle can never write into an undefined object. */
<<set $player_name to "">>
<<set $evidence to {}>>
<<set $attempts to {}>>
<<set $visited to {}>>
<<set $navEnabled to false>>
<<set $day to 0>>
<<set $accused to "">>


:: StoryScript [script]
/* ------------------------------------------------------------------ *
 * Murdered In Plain Text - story support code
 * ------------------------------------------------------------------ */

/* The evidence ledger. Each entry is one provable fact about the case.
   `keystone` marks the three items the accusation cannot be proven without. */
setup.evidence = [
	{
		id: "forged_note",
		day: 1,
		where: "The Study",
		title: "The Jokerman note",
		note: "A confession typeset in a font Sir Regex outlawed, signed with a name that fails validation and carrying no checksum. Not a suicide note. A forgery."
	},
	{
		id: "family_tree",
		day: 1,
		where: "The Study",
		title: "The XML lineage fragment",
		note: "Sir Regex's family recorded as a schema: one son DISOWNED, one niece flagged INVALID with <code>format=\"WebP\"</code>. He had already identified her."
	},
	{
		id: "signature_ledger",
		day: 1,
		where: "The Library",
		title: "The signature ledger",
		note: "Sir Regex was byte-level identifying his own household. The final row is a sample taken from his niece's certificate of authenticity."
	},
	{
		id: "lossy_tag",
		day: 1,
		where: "The Graphics Room",
		title: "The torn integrity tag",
		note: "A certificate tag claiming LOSSLESS - PROVENANCE VERIFIED, printed so badly the claim itself is full of compression artefacts. Torn from something."
	},
	{
		id: "tampered_batch",
		day: 1,
		where: "The Skull-ery",
		title: "The broken fixity check",
		note: "One biscuit in the tearoom batch no longer matches its published manifest. Its contents were altered after delivery."
	},
	{
		id: "ipres_flyer",
		day: 2,
		where: "St. Mary of the Lossless",
		title: "The iPres festival plan",
		note: "Vicar Vector saw a murder as a publicity event. A motive - but a planner's motive, not a poisoner's."
	},
	{
		id: "font_list",
		day: 2,
		where: "The .PUB",
		title: "The forbidden font list",
		note: "Colonel Win-ZIP compiled Sir Regex's banned typefaces and kept them for 'future publications'. Whoever set the note in Jokerman had this list."
	},
	{
		id: "love_letter",
		day: 2,
		where: "The Post Office",
		title: "The M.P.G. letter and birth record",
		note: "A secret affair, and a birth certificate naming Sir Regex as Jay Son Jnr.'s father. Motive enough for two suspects."
	},
	{
		id: "hex_gif",
		day: 2,
		where: "The Charming GIF",
		title: "The restored proto-meme",
		note: "Sir Regex smashing a looping toy, rendered twelve frames at a time. Merry Loopwell's grudge is real, and thirty years old."
	},
	{
		id: "ewe_an_notice",
		day: 2,
		where: "The Village Common",
		title: "The acquisition notice",
		note: "Sir Regex was evicting Ewe-an in the language of a deletion policy. Brutal, and a strong motive."
	},
	{
		id: "magic_bytes",
		day: 2,
		where: "The Nibble & Byte",
		title: "TIFF-any's file signature",
		note: "A RIFF container with the form type WEBP. She is not a lossless TIFF and never was. Her identity is a claim her own bytes refuse.",
		keystone: true
	},
	{
		id: "codicil",
		day: 3,
		where: "The Server Room",
		title: "The unsigned codicil",
		note: "Drafted at 19:40 on the night of the murder: TIFF-any struck from the estate for failed authentication. Never signed. He did not live to sign it.",
		keystone: true
	},
	{
		id: "payload",
		day: 3,
		where: "The Dark Archive",
		title: "The biscuit's payload",
		note: "The altered biscuit carried a routine that overwrites volatile memory. Enough to stop a man remembering what he meant to sign.",
		keystone: true
	},
	{
		id: "clippy_confession",
		day: 3,
		where: "The Pixelated Passages",
		title: "Clippy's housekeeping log",
		note: "The butler's own record of every item he 'tidied'. He did not kill Sir Regex. He normalised the evidence afterwards, on request."
	}
];

setup.evidenceById = function (id) {
	return setup.evidence.filter(function (item) { return item.id === id; })[0];
};

/* Log a fact. Returns false if it was already known, so callers can avoid
   announcing the same discovery twice. */
setup.log = function (id) {
	var found = State.variables.evidence;
	if (found[id]) { return false; }
	found[id] = true;
	return true;
};

setup.has = function (id) {
	return Boolean(State.variables.evidence[id]);
};

setup.evidenceCount = function () {
	return Object.keys(State.variables.evidence).length;
};

setup.keystones = function () {
	return setup.evidence.filter(function (item) { return item.keystone; });
};

setup.keystonesHeld = function () {
	return setup.keystones().filter(function (item) {
		return setup.has(item.id);
	}).length;
};

/* Attempt counters. Every puzzle gets two tries; the second failure is what
   costs you the clue, so a slip is survivable but carelessness is not. */
setup.bump = function (key) {
	var tries = State.variables.attempts;
	tries[key] = (tries[key] || 0) + 1;
	return tries[key];
};

setup.tries = function (key) {
	return State.variables.attempts[key] || 0;
};

/* Reading answers back out of plain HTML form controls. */
setup.val = function (id) {
	var el = document.getElementById(id);
	return el ? el.value : "";
};

setup.checked = function (id) {
	var el = document.getElementById(id);
	return Boolean(el && el.checked);
};

/* Compare free text loosely: case, spacing and punctuation are forgiven,
   the answer itself is not. */
setup.norm = function (value) {
	return String(value == null ? "" : value)
		.toLowerCase()
		.replace(/[^a-z0-9]+/g, "");
};

setup.answered = function (given, accepted) {
	var target = setup.norm(given);
	if (!target) { return false; }
	return accepted.some(function (option) {
		return setup.norm(option) === target;
	});
};

/* Score a set of <select> elements against their expected values. */
setup.score = function (expected) {
	return Object.keys(expected).filter(function (id) {
		return setup.val(id) === expected[id];
	}).length;
};

/* An exact-set check for checkbox puzzles: every right box ticked and no
   wrong ones. Partial credit is not preservation. */
setup.exactSet = function (all, correct) {
	var picked = all.filter(setup.checked);
	return picked.length === correct.length && correct.every(function (id) {
		return picked.indexOf(id) !== -1;
	});
};

setup.pickedCount = function (all) {
	return all.filter(setup.checked).length;
};

/* Mark the Start screen so the title card can style itself differently. */
$(document).on(":passagestart", function (ev) {
	$("body").toggleClass("start-screen", ev.passage.title === "Start");
});

/* Record which rooms have actually been entered, so Day 3 can tell the
   difference between evidence you lost and evidence you never looked for. */
$(document).on(":passageend", function (ev) {
	State.variables.visited[ev.passage.title] = true;
});

/* Accordion panels (Clippy's interrogation answers). */
$(document).on("click", ".accordion", function () {
	$(this).toggleClass("active");
	$(this).next(".panel").slideToggle(200);
});

/* Let players reveal the clickable regions of a map. Invisible hotspots are
   atmospheric, but a game you cannot find your way around is not. */
$(document).on("click", ".map-reveal", function () {
	$(this).closest(".map-figure").toggleClass("show-hotspots");
	var shown = $(this).closest(".map-figure").hasClass("show-hotspots");
	$(this).text(shown ? "Hide room outlines" : "Show room outlines");
});


:: StoryStylesheet [stylesheet]
@import url('https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@700&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap');

/* ==================================================================
   1. Design tokens
   Every colour and measure in the game resolves to one of these, so the
   look can be retuned from a single block.
   ================================================================== */
:root {
  --film:        #141312;   /* deepest black, the frame around everything */
  --ink:         #1C1B1A;   /* page black */
  --ink-raised:  #24221F;   /* panels sitting on the page */
  --ink-sunken:  #100F0E;   /* insets, terminals */
  --paper:       #EDEAE5;   /* body text on dark */
  --paper-bright:#FFFFF0;   /* headings */
  --paper-dim:   #9C948A;   /* captions, asides */
  --gold:        #C89F65;   /* the house accent */
  --gold-bright: #E4C48F;
  --ok:          #7FB77E;   /* verified */
  --bad:         #D98074;   /* corrupt */
  --rule:        #3A3733;   /* hairlines */
  --measure:     42rem;     /* comfortable reading width */
  --radius:      3px;       /* the period allows almost no rounding */
}

/* ==================================================================
   2. Page and typography
   ================================================================== */
body {
  background-color: var(--film);
  color: var(--paper);
  font-family: 'Libre Baskerville', Georgia, serif;
  /* Scales with the viewport instead of a flat 150%, which overflowed
     phones badly. */
  font-size: clamp(15px, 1.05rem + 0.15vw, 19px);
  line-height: 1.65;
  text-align: left;
}

/* The sidebar is replaced by the in-story case navigation. */
#ui-bar { display: none; }
#story { margin-left: 0; }

#passages {
  max-width: var(--measure);
  margin: 1.5em auto 4em;
  padding: 0 1.15rem;
}

.passage {
  margin: 0;
  padding: 0;
  text-align: left;   /* justified body text was breaking up badly at
                         narrow widths; justification is now reserved for
                         the letter and document components */
  hyphens: auto;
}

.passage p { margin: 0 0 1em; }

h1, h2, h3 {
  font-family: 'Cinzel Decorative', 'Libre Baskerville', serif;
  color: var(--paper-bright);
  line-height: 1.25;
  text-align: center;
  text-wrap: balance;
}

h1 {
  font-size: clamp(1.7rem, 1.3rem + 2.2vw, 2.9rem);
  margin: 0.2em 0 0.1em;
  letter-spacing: 0.01em;
}

h2 { font-size: clamp(1.25rem, 1.1rem + 1vw, 1.7rem); margin: 1.4em 0 0.5em; }
h3 { font-size: 1.1rem; margin: 1.2em 0 0.4em; letter-spacing: 0.06em; }

/* A hairline ornament under act and day headings. */
h1 + .rule, .rule {
  width: 6rem;
  height: 1px;
  margin: 0.9em auto 1.6em;
  background: linear-gradient(90deg, transparent, var(--gold), transparent);
  border: 0;
}

blockquote {
  margin: 1em auto;
  max-width: 34rem;
  color: var(--gold-bright);
  font-style: italic;
  text-align: center;
  border: 0;
}

a { color: var(--gold-bright); }
a:hover { color: var(--paper-bright); }

code, kbd, pre, .mono {
  font-family: ui-monospace, 'SF Mono', 'Cascadia Mono', Consolas,
               'Courier New', monospace;
}

code {
  background: var(--ink-sunken);
  color: var(--gold-bright);
  padding: 0.08em 0.35em;
  border-radius: 2px;
  font-size: 0.88em;
  word-break: break-word;
}

img { max-width: 100%; height: auto; }

.caption {
  color: var(--paper-dim);
  font-size: 0.85em;
  font-style: italic;
  text-align: center;
  margin: 0.5em auto 1.2em;
  max-width: 32rem;
}

/* ==================================================================
   3. Buttons and menus
   ================================================================== */
.start-menu {
  display: flex;
  justify-content: center;
  align-items: stretch;
  gap: 0.6em;
  flex-wrap: wrap;
  margin: 1.8em 0 0.6em;
}

.button,
button.button,
#passages .link-internal.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 2.75rem;          /* a real touch target */
  padding: 0.7em 1.15em;
  background-color: var(--ink);
  color: var(--gold);
  border: 1px solid var(--gold);
  border-radius: var(--radius);
  text-align: center;
  text-decoration: none;
  font-family: 'Libre Baskerville', Georgia, serif;
  font-size: 0.92rem;
  line-height: 1.25;
  cursor: pointer;
  transition: background-color .2s ease, color .2s ease, transform .08s ease;
}

.button:hover,
button.button:hover {
  background-color: var(--gold);
  color: var(--ink);
  transform: translateY(-1px);
}

.button:active,
button.button:active { transform: translateY(1px); }

.button--quiet {
  border-color: var(--rule);
  color: var(--paper-dim);
}
.button--quiet:hover {
  background-color: var(--ink-raised);
  color: var(--paper);
  border-color: var(--paper-dim);
}

.button--primary {
  border-width: 2px;
  color: var(--gold-bright);
  font-weight: 700;
}

/* <<link>> and <<return>> render as plain anchors; they sit beside real
   buttons in the same menus, so they get the same treatment. */
.start-menu > a,
.start-menu > a.link-internal {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 2.75rem;
  padding: 0.7em 1.15em;
  background-color: var(--ink);
  color: var(--gold-bright);
  border: 2px solid var(--gold);
  border-radius: var(--radius);
  text-decoration: none;
  font-family: 'Libre Baskerville', Georgia, serif;
  font-size: 0.92rem;
  font-weight: 700;
  line-height: 1.25;
  cursor: pointer;
  transition: background-color .2s ease, color .2s ease, transform .08s ease;
}

.start-menu > a:hover { background-color: var(--gold); color: var(--ink); transform: translateY(-1px); }
.start-menu > a::after { content: none; }

/* SugarCube renders every newline in passage source as a <br>. Inside a grid
   or flex container those become stray items that shove the real content out
   of place, and between blocks they become dead vertical space. Layout
   containers therefore drop them; prose, letters and terminal output keep
   theirs, which is where line breaks are actually meant. */
.start-menu > br,
.case-nav > br,
.map-figure > br,
.map-tools > br,
.room-list > br,
.dossier-grid > br,
.char-key > br,
.character-page > br,
.evidence-grid > br,
.puzzle > br,
.puzzle-brief > br,
.specimen-row > br,
.question > br,
.option > br,
.verdict > br { display: none; }

.brief-sep { display: block; height: 0.8em; }

/* One visible focus treatment for everything keyboard-reachable. */
a:focus-visible,
.button:focus-visible,
button:focus-visible,
input:focus-visible,
select:focus-visible,
.hotspot:focus-visible,
.accordion:focus-visible {
  outline: 2px solid var(--gold-bright);
  outline-offset: 2px;
  border-radius: var(--radius);
}

/* ==================================================================
   4. Case navigation
   ================================================================== */
.case-nav {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  gap: 0.45em;
  margin: 0 auto 1.8em;
  padding: 0.55em 0.6em;
  background: var(--ink);
  border-top: 1px solid var(--rule);
  border-bottom: 1px solid var(--rule);
  font-size: 0.8rem;
}

.case-nav a {
  color: var(--paper-dim);
  text-decoration: none;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  padding: 0.35em 0.7em;
  border: 1px solid transparent;
  border-radius: var(--radius);
}

.case-nav a:hover {
  color: var(--gold-bright);
  border-color: var(--rule);
}

.case-nav .case-day {
  color: var(--gold);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  padding: 0.35em 0.7em;
  border-right: 1px solid var(--rule);
  margin-right: 0.2em;
}

.case-nav .case-tally { color: var(--paper-dim); }
.case-nav .case-tally strong { color: var(--gold-bright); }

/* ==================================================================
   5. Silent-movie frame and intertitles
   ================================================================== */
.silent-movie-frame {
  position: relative;
  background-color: var(--ink);
  color: var(--paper-bright);
  padding: clamp(1.2rem, 4vw, 2.2rem);
  border: 8px solid var(--paper-bright);
  max-width: var(--measure);
  margin: 0 auto 1.5em;
}

.corner {
  position: absolute;
  width: 46px;
  height: 46px;
  background-size: contain;
  background-repeat: no-repeat;
  z-index: 2;
  pointer-events: none;
}
/* These pointed at github.com/.../blob/ URLs in a folder that does not
   exist, so no corner ever loaded. Now relative to the repository root,
   which also means the game works offline and in any fork. */
.corner.tl { top: -8px; left: -8px;
  background-image: url("Images/Border_images/TopLeft.png"); }
.corner.tr { top: -8px; right: -8px;
  background-image: url("Images/Border_images/TopRight.png"); }
.corner.bl { bottom: -8px; left: -8px;
  background-image: url("Images/Border_images/BottomLeft.png"); }
.corner.br { bottom: -8px; right: -8px;
  background-image: url("Images/Border_images/BottomRight.png"); }

.inner { position: relative; z-index: 1; }

/* Day and act cards, in the manner of a silent-film intertitle. */
.intertitle {
  max-width: 34rem;
  margin: 2.5em auto;
  padding: 2em 1.5em;
  background: var(--ink);
  border: 3px double var(--paper-bright);
  text-align: center;
}

.intertitle h1, .intertitle h2 { margin-top: 0; }

.intertitle .intertitle-kicker {
  display: block;
  font-family: ui-monospace, 'Courier New', monospace;
  font-size: 0.75rem;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 0.8em;
}

/* ==================================================================
   6. Maps: responsive, keyboard-reachable hotspots
   The hotspots used to be absolutely positioned in pixels over a fixed
   800px image, so they drifted off the rooms as soon as the image had to
   shrink. They are positioned in percentages now and scale with it.
   ================================================================== */
.map-figure {
  position: relative;
  display: block;
  max-width: 800px;
  margin: 0 auto 0.5em;
  line-height: 0;
}

.map-figure img {
  display: block;
  width: 100%;
  height: auto;
  border: 1px solid var(--rule);
}

.hotspot {
  position: absolute;
  display: block;
  border: 2px solid transparent;
  border-radius: var(--radius);
  transition: background-color .2s ease, border-color .2s ease;
}

.hotspot::after { content: none !important; }   /* no external-link glyph */

.hotspot:hover,
.map-figure.show-hotspots .hotspot {
  background-color: rgba(200, 159, 101, 0.16);
  border-color: var(--gold);
}

.map-tools {
  display: flex;
  justify-content: center;
  gap: 0.5em;
  flex-wrap: wrap;
  line-height: 1.5;
  margin-bottom: 1.2em;
}

.map-reveal {
  background: none;
  border: 1px solid var(--rule);
  border-radius: var(--radius);
  color: var(--paper-dim);
  font-family: inherit;
  font-size: 0.78rem;
  letter-spacing: 0.06em;
  padding: 0.45em 0.9em;
  cursor: pointer;
  min-height: 2.2rem;
}
.map-reveal:hover { color: var(--gold-bright); border-color: var(--gold); }

/* Room labels listed under a map, so the map is never the only way in. */
.room-list {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
  gap: 0.5em;
  margin: 0 0 1.5em;
  padding: 0;
  list-style: none;
}
.room-list a {
  display: block;
  padding: 0.6em 0.8em;
  background: var(--ink);
  border: 1px solid var(--rule);
  border-radius: var(--radius);
  text-decoration: none;
  font-size: 0.88rem;
}
.room-list a:hover { border-color: var(--gold); background: var(--ink-raised); }
.room-list .done { color: var(--paper-dim); }
.room-list .done::before { content: "\2713\00a0"; color: var(--ok); }

/* ==================================================================
   7. Documents: letters, notes, doormats
   ================================================================== */
.letter-style,
.comic-sans-letter,
.doormat-style {
  max-width: 38rem;
  margin: 1.8em auto;
  padding: clamp(1.4rem, 4vw, 2.5rem);
  border-radius: var(--radius);
  text-align: left;
  text-justify: inter-word;
}

.letter-style {
  background: linear-gradient(to bottom, #FDF6E3, #F2E7C9);
  border: 1px solid #D8CFC4;
  box-shadow: 0 10px 24px rgba(0,0,0,0.45), inset 0 0 40px rgba(120,96,58,0.10);
  font-family: Georgia, 'Times New Roman', serif;
  color: #3A352E;
  line-height: 1.7;
}

.letter-style h2, .letter-style h3 { color: #2C2823; }
.letter-style code { background: rgba(0,0,0,0.07); color: #5A4326; }
.letter-style hr { border: 0; border-top: 1px solid #D3C7B0; margin: 1.2em 0; }

/* Clippy's interruptions, and every failure state he causes. */
.comic-sans-letter {
  background-color: #FDF6E3;
  border: 2px solid #111;
  box-shadow: 6px 6px 0 rgba(0,0,0,0.35);
  font-family: 'Comic Sans MS', 'Chalkboard SE', cursive, sans-serif;
  color: #141414;
  line-height: 1.6;
}
.comic-sans-letter h2 { font-family: inherit; }
.comic-sans-letter code { background: rgba(0,0,0,0.08); color: #7A2418; }

.doormat-style {
  background: repeating-linear-gradient(45deg,
    #D2B48C, #D2B48C 10px, #C2A679 10px, #C2A679 20px);
  border: 3px solid #8B6F47;
  box-shadow: inset 0 0 14px rgba(0,0,0,0.28);
  font-family: Georgia, serif;
  color: #332B20;
  text-align: center;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  font-weight: 700;
}

/* ==================================================================
   8. Digital artefacts: terminals, hex dumps, records
   ================================================================== */
.terminal {
  max-width: 40rem;
  margin: 1.6em auto;
  padding: 1.2em 1.3em;
  background: var(--ink-sunken);
  border: 1px solid #2E4A33;
  border-radius: var(--radius);
  box-shadow: inset 0 0 34px rgba(40, 120, 60, 0.10);
  color: #B8E0BE;
  font-family: ui-monospace, 'Courier New', monospace;
  font-size: 0.86rem;
  line-height: 1.6;
  text-align: left;
}

.terminal h3 {
  font-family: inherit;
  color: #7FD48F;
  text-align: left;
  margin: 0 0 0.8em;
  font-size: 0.86rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}

.terminal code { background: rgba(127, 212, 143, 0.12); color: #D6F5DB; }
.terminal .prompt { color: #7FD48F; }
.terminal .dim { color: #6C8A72; }

.hexdump {
  overflow-x: auto;
  margin: 1em 0;
  padding: 0.9em 1em;
  background: #0B0A09;
  border: 1px solid var(--rule);
  border-radius: var(--radius);
  color: var(--gold-bright);
  font-family: ui-monospace, 'Courier New', monospace;
  font-size: 0.82rem;
  line-height: 1.85;
  white-space: pre;
  text-align: left;
}
.hexdump .offset { color: #6E665C; }
.hexdump .hl { background: rgba(200, 159, 101, 0.22); color: #FFF3DC; }

pre {
  overflow-x: auto;
  max-width: 100%;
  padding: 0.9em 1em;
  background: var(--ink-sunken);
  border: 1px solid var(--rule);
  border-radius: var(--radius);
  font-size: 0.82rem;
  line-height: 1.6;
  text-align: left;
}

/* ==================================================================
   9. Puzzle furniture
   ================================================================== */
.puzzle {
  max-width: 40rem;
  margin: 1.6em auto;
  text-align: left;
}

.puzzle-brief {
  padding: 1em 1.2em;
  margin-bottom: 1.4em;
  background: var(--ink);
  border-left: 3px solid var(--gold);
  border-radius: 0 var(--radius) var(--radius) 0;
  font-size: 0.94em;
}

.puzzle-brief strong { color: var(--gold-bright); }

.question {
  padding: 1em 1.15em;
  margin-bottom: 1em;
  background: var(--ink);
  border: 1px solid var(--rule);
  border-radius: var(--radius);
}

.question > p:first-child { margin-top: 0; }
.question > p:last-child { margin-bottom: 0; }
.question .q-no {
  display: inline-block;
  min-width: 1.6em;
  color: var(--gold);
  font-family: ui-monospace, 'Courier New', monospace;
}

/* Rows of "tick every one that applies" options. */
.option {
  display: flex;
  align-items: flex-start;
  gap: 0.7em;
  padding: 0.6em 0.7em;
  margin: 0.35em 0;
  background: var(--ink-raised);
  border: 1px solid var(--rule);
  border-radius: var(--radius);
  cursor: pointer;
}
.option:hover { border-color: var(--gold); }
.option input { margin-top: 0.35em; flex: 0 0 auto; accent-color: var(--gold); }
.option span { flex: 1; }
.option code { font-size: 0.85em; }

/* Native controls are illegible on a dark ground until they are told
   what colours to use. */
select, input[type="text"], input[type="number"], textarea {
  width: 100%;
  box-sizing: border-box;
  min-height: 2.6rem;
  padding: 0.55em 0.7em;
  background: var(--ink-sunken);
  color: var(--paper);
  border: 1px solid var(--gold);
  border-radius: var(--radius);
  font-family: ui-monospace, 'Courier New', monospace;
  font-size: 0.92rem;
}

select option { background: var(--ink); color: var(--paper); }

input[type="checkbox"], input[type="radio"] {
  width: 1.05rem;
  height: 1.05rem;
  accent-color: var(--gold);
}

.field-label {
  display: block;
  margin: 0.9em 0 0.3em;
  color: var(--paper-dim);
  font-size: 0.8rem;
  letter-spacing: 0.09em;
  text-transform: uppercase;
}

/* Two-column layouts inside puzzles (specimen beside its verdict). */
.specimen-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 0.7em;
  padding: 0.9em 1em;
  margin-bottom: 0.8em;
  background: var(--ink);
  border: 1px solid var(--rule);
  border-radius: var(--radius);
}
@media (min-width: 40rem) {
  .specimen-row { grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); align-items: center; }
}
.specimen-row .specimen {
  font-family: ui-monospace, 'Courier New', monospace;
  font-size: 0.84rem;
  color: var(--gold-bright);
  word-break: break-word;
}
.specimen-row .specimen small { display: block; color: var(--paper-dim); font-family: 'Libre Baskerville', serif; }

/* Verdict banners after a submission. */
.verdict {
  max-width: 40rem;
  margin: 1.6em auto;
  padding: 1.3em 1.4em;
  border-radius: var(--radius);
  text-align: left;
}
.verdict h2 {
  margin: 0 0 0.6em;
  text-align: left;
  font-family: ui-monospace, 'Courier New', monospace;
  font-size: 1rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}
.verdict--ok  { background: rgba(127,183,126,0.10); border: 1px solid var(--ok); }
.verdict--ok h2 { color: var(--ok); }
.verdict--bad { background: rgba(217,128,116,0.10); border: 1px solid var(--bad); }
.verdict--bad h2 { color: var(--bad); }
.verdict--warn { background: rgba(200,159,101,0.10); border: 1px solid var(--gold); }
.verdict--warn h2 { color: var(--gold-bright); }

.attempts {
  display: inline-block;
  margin-top: 0.6em;
  padding: 0.25em 0.6em;
  border: 1px dashed var(--gold);
  border-radius: var(--radius);
  color: var(--gold-bright);
  font-family: ui-monospace, 'Courier New', monospace;
  font-size: 0.76rem;
  letter-spacing: 0.08em;
}

/* ==================================================================
   10. The case file
   ================================================================== */
.evidence-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  gap: 0.8em;
  margin: 1em 0 2em;
  text-align: left;
}

.evidence-card {
  padding: 0.95em 1.05em;
  background: var(--ink);
  border: 1px solid var(--rule);
  border-left: 3px solid var(--gold);
  border-radius: 0 var(--radius) var(--radius) 0;
  font-size: 0.88rem;
}

.evidence-card h3 {
  margin: 0 0 0.35em;
  text-align: left;
  font-family: 'Libre Baskerville', serif;
  font-size: 0.98rem;
  letter-spacing: 0;
  color: var(--paper-bright);
}

.evidence-card .where {
  display: block;
  color: var(--paper-dim);
  font-size: 0.74rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  margin-bottom: 0.5em;
}

.evidence-card p { margin: 0; }

.evidence-card--keystone { border-left-color: var(--ok); }
.evidence-card--keystone .where { color: var(--ok); }

/* Items you never recovered: present in the index, absent from the file. */
.evidence-card--missing {
  border-left-color: var(--bad);
  border-style: dashed;
  color: var(--paper-dim);
}
.evidence-card--missing h3 { color: var(--paper-dim); }
.evidence-card--missing .redacted {
  display: inline-block;
  background: var(--bad);
  color: var(--bad);
  border-radius: 2px;
  user-select: none;
}

.ledger-summary {
  max-width: 40rem;
  margin: 0 auto 1.5em;
  padding: 1em 1.2em;
  background: var(--ink);
  border: 1px solid var(--rule);
  border-radius: var(--radius);
  font-family: ui-monospace, 'Courier New', monospace;
  font-size: 0.84rem;
  text-align: left;
}
.ledger-summary strong { color: var(--gold-bright); }
.ledger-summary .ok { color: var(--ok); }
.ledger-summary .bad { color: var(--bad); }

/* Announcing a new find, inline, where it happens. */
.logged {
  display: block;
  max-width: 40rem;
  margin: 1.2em auto;
  padding: 0.7em 1em;
  background: rgba(127,183,126,0.10);
  border: 1px solid var(--ok);
  border-radius: var(--radius);
  color: var(--ok);
  font-family: ui-monospace, 'Courier New', monospace;
  font-size: 0.78rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  text-align: center;
}

/* ==================================================================
   11. Character dossiers
   The per-passage copies of this block (one in every character page)
   are gone; it lives here once.
   ================================================================== */
.dossier-grid {
  display: grid;
  /* was a hard six columns, which left phone portraits a few pixels wide */
  grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr));
  gap: 0.7em;
  width: 100%;
  margin: 1.2em auto 0;
}

.char {
  position: relative;
  display: block;
  text-decoration: none;
  cursor: pointer;
}

.char img {
  display: block;
  width: 100%;
  height: auto;
  border-radius: var(--radius);
  border: 3px solid transparent;
  transition: transform .2s ease, box-shadow .2s ease;
}

.char.detective img { border-color: var(--paper-bright); }
.char.victim    img { border-color: #6E9BD8; }
.char.witness   img { border-color: var(--ok); }
.char.suspect   img { border-color: var(--bad); }

.char:hover img { transform: scale(1.03); box-shadow: 0 6px 18px rgba(0,0,0,0.5); }

.char .char-name {
  display: block;
  margin-top: 0.3em;
  color: var(--paper-dim);
  font-size: 0.72rem;
  letter-spacing: 0.04em;
  text-align: center;
  line-height: 1.3;
}

.char-key {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 0.9em;
  margin: 0.6em 0 0;
  color: var(--paper-dim);
  font-size: 0.74rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}
.char-key span::before {
  content: "\25A0\00a0";
  font-size: 1.1em;
}
.char-key .k-suspect::before   { color: var(--bad); }
.char-key .k-victim::before    { color: #6E9BD8; }
.char-key .k-witness::before   { color: var(--ok); }
.char-key .k-detective::before { color: var(--paper-bright); }

/* A single character's page. */
.character-page {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 1.2em;
  max-width: 40rem;
  margin: 1em auto;
  text-align: left;
}
@media (min-width: 34rem) {
  .character-page { grid-template-columns: 13rem minmax(0, 1fr); align-items: start; }
}

.character-page .char-image img {
  width: 100%;
  border-radius: var(--radius);
  border: 1px solid var(--rule);
}

.character-page .char-text { line-height: 1.5; }
.character-page .char-text h2 { margin: 0 0 0.5em; text-align: left; }
.character-page .char-text p { margin: 0.3em 0; }
.character-page .char-text b { color: var(--gold); font-weight: 400;
  font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; }

/* ==================================================================
   12. Accordions (Clippy's answers)
   ================================================================== */
.accordion {
  display: block;
  width: 100%;
  background-color: var(--ink);
  color: var(--gold);
  cursor: pointer;
  padding: 0.8em 1em;
  text-align: left;
  border: 1px solid var(--rule);
  border-radius: var(--radius);
  font-family: 'Libre Baskerville', serif;
  font-size: 0.9rem;
  margin-bottom: 0.4em;
  transition: background-color .2s;
}

.accordion:hover, .accordion.active {
  background-color: var(--ink-raised);
  color: var(--gold-bright);
  border-color: var(--gold);
}

.accordion::after { content: "\002B"; float: right; color: var(--paper-dim); }
.accordion.active::after { content: "\2212"; }

.panel {
  display: none;
  padding: 0.2em 1.1em;
  margin: -0.2em 0 0.9em;
  background: var(--ink-raised);
  border: 1px solid var(--rule);
  border-top: 0;
  border-radius: 0 0 var(--radius) var(--radius);
  text-align: left;
  font-size: 0.92em;
}

/* ==================================================================
   13. Snow, and respecting people who do not want it
   ================================================================== */
@keyframes snowfall { to { transform: translateY(105vh); } }

.snowflake {
  position: fixed;
  top: -5%;
  z-index: 9999;
  background: #FFF;
  border-radius: 50%;
  opacity: 0.55;
  pointer-events: none;
  animation: snowfall linear infinite;
}

@media (prefers-reduced-motion: reduce) {
  .snowflake { display: none; }
  * { animation-duration: 0.001s !important; transition-duration: 0.001s !important; }
}

/* ==================================================================
   14. Title screen
   ================================================================== */
.start-screen #passages { margin-top: 3em; }

.title-card { text-align: center; }

.title-card .byline {
  color: var(--paper-dim);
  font-size: 0.78rem;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  margin-top: 2.5em;
}

/* ==================================================================
   15. Map hotspot grid
   Measured off the map artwork itself (1600x709, rooms drawn as a
   4-then-3 dashed grid) and expressed as percentages, so a hotspot
   stays over its room at every width. The old pixel offsets were
   measured against a different assumption and sat well below the
   rooms they were meant to cover.
   ================================================================== */
.map-figure .r1 { top: 17.91%; height: 28.77%; }
.map-figure .r2 { top: 53.17%; height: 28.77%; }

.map-figure .c4-1 { left:  1.06%; width: 24.25%; }
.map-figure .c4-2 { left: 25.31%; width: 24.31%; }
.map-figure .c4-3 { left: 49.63%; width: 24.25%; }
.map-figure .c4-4 { left: 73.88%; width: 24.25%; }

.map-figure .c3-1 { left:  1.06%; width: 32.38%; }
.map-figure .c3-2 { left: 33.44%; width: 32.38%; }
.map-figure .c3-3 { left: 65.81%; width: 32.31%; }


:: Widgets [widget]
<<widget "snow">>
	<<for _i to 0; _i < 40; _i++>>
		<<set _size to random(2, 7)>>
		<<set _left to random(0, 100)>>
		<<set _duration to random(11, 22)>>
		<<set _delay to random(0, 14)>>
		<div class="snowflake" style="width: <<print _size>>px; height: <<print _size>>px; left: <<print _left>>vw; animation-duration: <<print _duration>>s; animation-delay: -<<print _delay>>s;"></div>
	<</for>>
<</widget>>

/* Log one piece of evidence and announce it, but only the first time. */
<<widget "logged">>
	<<if setup.log(_args[0])>>
		<span class="logged">Logged to case file &mdash; <<= setup.evidenceById(_args[0]).title>></span>
	<</if>>
<</widget>>

/* The two-attempt counter shared by every puzzle. */
<<widget "attemptnote">>
	<span class="attempts">Attempt <<= setup.tries(_args[0])>> of 2</span>
<</widget>>


:: PassageHeader
<<if $navEnabled and not ["Start", "Introducing", "Start the game", "Characters", "Case File", "Commendations", "Character Sheets", "The Inspector's Timeline", "End credits"].includes(passage())>>\
<nav class="case-nav">
	<span class="case-day">Day <<= $day>></span>
	<<link "Case file">><<goto "Case File">><</link>>
	<<link "Dossier">><<goto "Character Sheets">><</link>>
	<<link "Timeline">><<goto "The Inspector's Timeline">><</link>>
	<span class="case-tally"><strong><<= setup.evidenceCount()>></strong> / <<= setup.evidence.length>> exhibits</span>
</nav>
<</if>>


:: Start
<<snow>>\
<div class="title-card">
	<h1>Murdered in Plain Text</h1>
	<hr class="rule">
	<blockquote><em>The ASCII was clear, but the motive wasn't.</em></blockquote>

	<div class="start-menu">
		<button class="button button--primary" data-passage="Introducing">Open the case</button>
		<button class="button" data-passage="Characters">The village</button>
	</div>

	<p class="byline">A Bits &amp; Bots mystery &middot; three days &middot; fourteen exhibits</p>
</div>


:: Introducing
You, the famous digital preservationist detective, need a moniker.

<span class="field-label">Enter the name you will sign your report with</span>
<<textbox "$player_name" "">>

<div class="start-menu">
	<<link "Nice to meet you" "Start the game">>
		<<if $player_name.trim() is "">><<set $player_name to "Detective">><</if>>
		<<set $player_name to $player_name.trim()>>
	<</link>>
</div>


:: Start the game [Story]
Welcome, $player_name. Your reputation precedes you. The pages of <em>The Daily E-Mail</em> and <em>The Checksum Chronicle</em> are filled with your exploits: "The Riddle of the Ghost in the Cloud Storage", "The Mystery of the Misfiled Metadata", and of course your recent triumph in "The Case of the Bit Rot Bandit".

Your skills are legendary. Tonight, they are needed.

It has been a long day of checksum chases. With a weary sigh you sink into your chair, ready to relax with a lukewarm, bitstream-brewed chamomile tea &mdash; perfectly formatted for long-term preservation, unlike your energy levels.

Just as you begin to drift into a pleasant state of data refresh&hellip; <strong>thump</strong>.

Was that a corrupted WAV file echoing through the hallway? Or something far less&hellip; backed up?

<div class="start-menu">
	<button class="button button--primary" data-passage="Go and investigate">Run a forensic analysis (go and investigate)</button>
	<button class="button" data-passage="Head to bed, the chamomile tea has really kicked in">Initiate sleep mode</button>
	<button class="button button--quiet" data-passage="Profile">Check your own credentials</button>
</div>


:: Profile
<div class="character-page">
	<div class="char-image">
		<img src="Images/Portraits/Detective.png" alt="A portrait of the detective">
	</div>
	<div class="char-text">
		<h2>$player_name</h2>
		<p><b>Occupation</b><br>Consultant in digital preservation and amateur sleuth</p>
		<p><b>Favourite location</b><br>Metadata Manor's dusty archives</p>
		<p><b>Quote</b><br>&ldquo;This could be important evidence.&rdquo;</p>
		<p><b>Hobby</b><br>Listening to true-crime podcasts at double speed</p>
		<p><b>Village reputation</b><br>A bit mysterious, but welcomed &mdash; for now</p>
		<p><b>Pet peeve</b><br>Sticky notes with no metadata</p>
	</div>
</div>

<div class="start-menu">
	<button class="button" data-passage="Start the game">Back to the evening</button>
</div>


:: Go and investigate
As you peer nervously around the corner, your heart performing an unscheduled backup, you see &mdash; at first glance &mdash; nothing out of the ordinary.

Just your faithful doormat, embossed with its usual friendly greeting:

<div class="doormat-style">Welcome. But Please Migrate Your Shoes First</div>

But then you notice it.

Resting neatly in the middle, perfectly aligned as if digitally deposited, is an envelope. Its edges are crisp &mdash; too crisp. Almost freshly rendered.

It is stamped with today's date and, unmistakably, <em>$player_name</em> in firm archival ink.

<div class="letter-style">Extremely urgent! No, really &mdash; this isn't one of those fake &ldquo;priority metadata&rdquo; notices. Seriously, open me.</div>

The air hums faintly, like a hard drive spinning up in the dark. Somewhere, a faint giggle of corrupted data trails off into silence.

<div class="start-menu">
	<button class="button button--primary" data-passage="Read the letter">Read the letter</button>
</div>


:: Read the letter
<div class="letter-style">
<p>Dear $player_name,</p>

<p>Before you read this, I may well be gone &mdash; checksummed out of existence, perhaps. Troublesome things are afoot. My situation here in Checksum-on-the-Wold has&hellip; fragmented. Everything appears too lossless. The metadata matches too neatly, the streets are overly normalized, and even the parish database never throws an error. Something here has been over-curated, or worse, rebuilt from a malicious backup.</p>

<p>I can no longer distinguish authenticity from duplication. Everyone here smiles with terrifying checksum precision, but no one blinks.</p>

<p>I have spent this month <em>validating my own household</em>, byte by byte, and I do not like what the signatures tell me. One member of my family is not the format they claim to be. My solicitor has the paperwork; I need only sign it.</p>

<p>If this message reaches you uncorrupted, I beg you to come at once. I am afraid I have encountered a dangerous flaw in the family tree.</p>

<p>The only soul I still trust is HUScar Wilde, the village wraith &mdash; half ghost, half sysadmin &mdash; who tends the hedges, and the network, with his chainsaw hands. He alone seems to remember what once was, before the great Reformatting.</p>

<p>Come quickly, before I am migrated to an obsolete format.</p>

<p>Yours, in hash and hope,<br>
<strong>Sir Regex Metadata IV</strong><br>
<code>sha256: 9f2c4e&hellip;a17b &mdash; verify before acting</code></p>
</div>

<div class="start-menu">
	<button class="button button--primary" data-passage="Fold up the letter">Fold up the letter</button>
</div>


:: Fold up the letter
As you finish reading, the edges of the letter begin to flicker &mdash; like a corrupted PDF trying to render a missing font. For a moment the words shimmer, rearranging themselves slightly:

<div class="terminal">
<span class="prompt">&gt;</span> "Before you read this, I may&hellip; gone&hellip; Troublesome&hellip; checksum&hellip; HUS-car Wild&hellip;"
<span class="dim">&gt; render aborted: authority font not found</span>
</div>

The flicker lasts only a few seconds, but long enough to make you wonder whether the letter is trying to update its own metadata, or warn you of something unspeakably digital lurking nearby.

You note the hash at the foot of the page and, out of habit, verify it. It matches. Whatever else is false in Checksum-on-the-Wold, this letter is genuinely his.

<em>Remember that.</em> It is the last document in this case you will be able to say that about.

You jump in the car and start driving. Despite the frosty roads, you know it is imperative that you reach Checksum-on-the-Wold in time.

<div class="start-menu">
	<button class="button button--primary" data-passage="Make way to the village">Make way to the village</button>
</div>


:: Make way to the village [Story]
<<snow>>\
Night starts falling, and as you head for Sir Regex's house you see that the snow has set in. You drive faster. The roads to the village and the manor are windy, and you do not want to get snowed in.

When you pass the gates you glance upon a dark figure in the garden, carving a hedge into a shape you cannot quite resolve. Suddenly you get an uneasy feeling, and begin to wonder whether you should have come at all.

You fight your nerves, and park the car.

<div class="start-menu">
	<button class="button" data-passage="Enter the house 1">Approach along the drive</button>
</div>


:: Enter the house 1
<img src="Images/manor.png" alt="Metadata Manor at night, under snow">
<p class="caption">Metadata Manor. Four wings, three days, one unsigned document.</p>

<div class="start-menu">
	<button class="button button--primary" data-passage="Enter the house">Knock on the door</button>
</div>


:: Enter the house [Story]
Upon arriving at Metadata Manor you are greeted by Clippy the Butler in the foyer. The butler looks less upset and more like a badly rendered question mark.

"Greetings, Detective $player_name! It looks like you're trying to solve a murder. Would you like some help with that? Sir Regex and I were anticipating your arrival, though not under these&hellip; tragically low-resolution circumstances. The snow has performed a perfect geographic isolation, ensuring you have three days of pure, uninterrupted sleuthing."

He contorts into the shape of a magnifying glass. "I am here to assist. Should you need to rephrase an accusation, or select a properly formatted blunt object, just ask."

You notice that the foyer is immaculate. Not tidy &mdash; immaculate. The kind of clean that takes effort, and takes it recently.

The network is down, the roads are blocked, and a murder has occurred. It is time to find the corrupting element in the system of Checksum-on-the-Wold.

<div class="start-menu">
	<button class="button button--primary" data-passage="Talk to Clippy">Talk to Clippy</button>
</div>


:: Talk to Clippy [Story]
"The facts, then. Sir Regex was found in the Study at twenty past eight this evening. No wound, no struggle, no poison the police could name. His pen was uncapped and his desk was bare." Clippy bends thoughtfully into the shape of a bookmark. "A confession was discovered beside him, which I am told closes the matter."

"You do not sound convinced," you say.

"I am a butler. I am not paid to be convinced." He straightens. "I have placed the Manor's structural metadata &mdash; the map &mdash; on the foyer table. We begin proper forensic work tomorrow, but tonight you may deep-scan the crime scene and the adjacent wings. Four rooms are unlocked. I would not delay: things here have a habit of being tidied."

